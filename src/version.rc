// Version resource for DarkPicturesRT.addon64 (see version.h).
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     DPRT_VERSION_MAJOR, DPRT_VERSION_MINOR, DPRT_VERSION_PATCH, 0
PRODUCTVERSION  DPRT_VERSION_MAJOR, DPRT_VERSION_MINOR, DPRT_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      DPRT_PRODUCT
            VALUE "FileDescription",  DPRT_RC_DESCRIPTION
            VALUE "FileVersion",      DPRT_VERSION
            VALUE "InternalName",     DPRT_PRODUCT
            VALUE "LegalCopyright",   "Copyright (c) 2026 Scott Dinwiddie. MIT License."
            VALUE "OriginalFilename", DPRT_RC_FILENAME
            VALUE "ProductName",      DPRT_RC_PRODUCT
            VALUE "ProductVersion",   DPRT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
